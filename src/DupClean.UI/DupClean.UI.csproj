<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DupClean</AssemblyName>
    <RootNamespace>DupClean.UI</RootNamespace>

    <!-- 탐색기·작업 표시줄에 보이는 EXE 아이콘 (tools\make_icon.ps1 로 생성) -->
    <ApplicationIcon>Assets\Icon\DupClean.ico</ApplicationIcon>

    <!-- 버전 정보 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>DupClean</Company>
    <Product>DupClean</Product>
    <Description>Windows 중복 파일 탐지 및 정리 도구</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DupClean.Core\DupClean.Core.csproj" />
  </ItemGroup>

  <!-- 글꼴(Figtree, SIL Open Font License)을 EXE 안에 포함 -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\OFL.txt" />
    <!-- 창 제목 표시줄 아이콘으로도 사용 -->
    <Resource Include="Assets\Icon\DupClean.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

</Project>
