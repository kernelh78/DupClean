<Window x:Class="DupClean.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="DupClean — 설정"
        Width="600" Height="740"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── 화면 테마 ─────────────────────────────── -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="화면 테마" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                        <TextBlock Text="선택하면 바로 적용됩니다. '저장'을 눌러야 다음 실행에도 유지됩니다."
                                   Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="시스템 설정" GroupName="Theme"
                                         Style="{StaticResource SegmentRadio}" Margin="0,0,8,0"
                                         IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"/>
                            <RadioButton Content="라이트" GroupName="Theme"
                                         Style="{StaticResource SegmentRadio}" Margin="0,0,8,0"
                                         IsChecked="{Binding IsThemeLight, Mode=TwoWay}"/>
                            <RadioButton Content="다크" GroupName="Theme"
                                         Style="{StaticResource SegmentRadio}"
                                         IsChecked="{Binding IsThemeDark, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 마스터 폴더 ─────────────────────────────── -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="마스터 폴더 (보호 폴더)" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                        <TextBlock Text="여기에 등록된 폴더의 파일은 자동 선택에서 제외됩니다."
                                   Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Height="150" Margin="0,0,0,10">
                            <ListBox ItemsSource="{Binding MasterFolders}"
                                     SelectedItem="{Binding SelectedFolder}"
                                     FontSize="12"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddFolderCommand}" Margin="0,0,8,0" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;"/>
                                    <TextBlock Text="폴더 추가" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveFolderCommand}" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;"/>
                                    <TextBlock Text="제거" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 유사 이미지 ─────────────────────────────── -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="유사 이미지 탐지" Style="{StaticResource Heading}" Margin="0,0,0,12"/>

                        <CheckBox Content="유사 이미지(pHash) 탐지 활성화"
                                  IsChecked="{Binding ComputePHash}"
                                  Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="유사도 임계값"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding PHashThreshold}"
                                    Minimum="1" Maximum="16"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding PHashThreshold}"
                                       FontWeight="SemiBold" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="16,0,0,0" Width="24"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="낮을수록 엄격 (거의 동일), 높을수록 느슨 (많이 달라도 유사로 판정). 기본값: 8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 하단 버튼 ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" IsCancel="True" Margin="0,0,8,0" MinWidth="84"/>
            <Button Content="저장" Style="{StaticResource PrimaryButton}" MinWidth="84"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
