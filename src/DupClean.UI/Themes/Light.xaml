<!--
  라이트 테마 색상. 값은 astryx(@astryxdesign/theme-neutral) 라이트 토큰에서 가져왔다.
  다크 테마(Dark.xaml)와 키 이름이 완전히 같아야 한다 — 실행 중 두 파일을 서로 바꿔 끼운다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 배경 -->
    <SolidColorBrush x:Key="BodyBrush"         Color="#F1F1F1"/>   <!-- color-background-body -->
    <SolidColorBrush x:Key="CardBrush"         Color="#FFFFFF"/>   <!-- color-background-card -->
    <SolidColorBrush x:Key="InputBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush"        Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedBrush"      Color="#14000000"/>
    <SolidColorBrush x:Key="SelectedBrush"     Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TrackBrush"        Color="#E2E2E2"/>   <!-- color-background-gray -->

    <!-- 테두리 -->
    <SolidColorBrush x:Key="BorderBrush"       Color="#14000000"/> <!-- color-border -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4D4"/>   <!-- color-border-emphasized -->

    <!-- 글자 -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#474747"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="#919191"/>

    <!-- 강조(주요 버튼·진행 바) : astryx neutral은 거의 검정 -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#1B1B1B"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#3A3A3A"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#F1F1F1"/>

    <!-- 상태색 -->
    <SolidColorBrush x:Key="ErrorBrush"         Color="#C9303A"/>
    <SolidColorBrush x:Key="ErrorHoverBrush"    Color="#A92730"/>
    <SolidColorBrush x:Key="OnErrorBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorMutedBrush"    Color="#FFC4BE"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#198100"/>
    <SolidColorBrush x:Key="SuccessMutedBrush"  Color="#BCE0BB"/>
    <SolidColorBrush x:Key="InfoBrush"          Color="#0074E2"/>
    <SolidColorBrush x:Key="InfoMutedBrush"     Color="#B9D7FF"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="#FFCE2F"/>

    <!-- 포커스 링 -->
    <SolidColorBrush x:Key="FocusBrush"         Color="#0074E2"/>

</ResourceDictionary>
