<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    ImageSharp 3.2.0 이상은 빌드할 때 Six Labors 라이선스 키가 필요하다 (없으면 Release 빌드 실패).
    저장소 루트의 sixlabors.lic 를 자동으로 사용한다. 이 파일은 .gitignore 에 들어 있어 커밋되지 않는다.
    다른 방법: 환경변수 SIXLABORS_LICENSE_KEY 또는 -p:SixLaborsLicenseFile=경로 로 직접 지정 (그러면 이 설정은 무시됨).
    키 신청: https://licensing.sixlabors.com  (자세한 내용은 README, report_v0.2.md 6장)
  -->
  <PropertyGroup Condition="'$(SixLaborsLicenseFile)' == '' And '$(SixLaborsLicenseKey)' == '' And Exists('$(MSBuildThisFileDirectory)..\sixlabors.lic')">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)..\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
</Project>
